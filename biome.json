{
	"$schema": "https://biomejs.dev/schemas/2.6.6/schema.json",
	"files": {
		"includes": [
			"client/src/**/*.ts",
			"server/**/*.ts",
			"shared/src/**/*.ts",
			"shared/test/**/*.ts",
			"server/test/**/*.ts",
			"client/test/**/*.ts"
		]
	},
	"formatter": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"rules": {
			"complexity": {
				"useLiteralKeys": "off"
			},
			"style": {
				"noNonNullAssertion": "off",
				"useTemplate": "off",
				"useExponentiationOperator": "off"
			},
			"suspicious": {
				"noExplicitAny": "off",
				"noConfusingVoidType": "off"
			},
			"correctness": {
				"noUnusedVariables": "off",
				"noUnusedImports": "off"
			}
		}
	}
}
